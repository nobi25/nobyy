NODE_ENV=development
PORT=3000
# Set false only for plain HTTP on your own local machine.
# Manus HTTPS Preview and public HTTPS must use true (the application default).
PUBLIC_PREVIEW=false
BASE_URL=http://localhost:3000
# Comma-separated trusted browser origins for cross-origin proxied Preview.
NOBY_PUBLIC_ORIGINS=http://localhost:3000
# Production requires a unique secret of at least 32 characters.
SESSION_SECRET=
# Optional first-owner bootstrap: choose a new email and a unique password of 14+ characters.
# Never put these values in source control or chat.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DATABASE_PATH=./data/noby.sqlite
# Optional exact publisher hostnames for authorized imports. Empty disables imports.
INGEST_ALLOWLIST=
# Compatible provider for the optional worker only; no worker is started by npm start.
OPENAI_API_KEY=
OPENAI_API_BASE=
NOBY_VISION_MODEL=gpt-4o-mini
NOBY_MIN_CONFIDENCE=0.55
NOBY_WATERMARK=Noby • نوبي
NOBY_GENERATED_DIR=./public/generated
NOBY_JOBS_DIR=./data/jobs
NOBY_WORKER_POLL_MS=15000
